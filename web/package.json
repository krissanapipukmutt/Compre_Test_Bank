{
  "name": "compre-study",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "validate:data": "../.venv/bin/python ../scripts/validate_data.py --phase 8 && python3 ../scripts/validate_translation_integrity.py && ../.venv/bin/python ../scripts/normalize_question_structure.py --check && ../.venv/bin/python ../scripts/validate_phase11.py && ../.venv/bin/python ../scripts/validate_final_readability.py && ../.venv/bin/python ../scripts/audit_exam_study_coverage.py --check && ../.venv/bin/python ../scripts/validate_exam_study_coverage.py",
    "check": "npm run validate:data && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
